{
  "homepage": "https://auv-iitk.github.io",
  "name": "auv-website",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.7.9",
    "classnames": "^2.5.1",
    "sass": "^1.83.0",
    "nouislider": "13.1.5",
    "react": "^18.3.1",
    "react-bootstrap": "^1.6.0",
    "react-dom": "^18.3.1",
    "react-icons": "^4.11.0",
    "react-multi-carousel": "^2.6.3",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-scripts": "^5.0.1",
    "reactstrap": "8.0.0",
    "styled-components": "^6.1.13"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src --fix --ext .js,.jsx",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile-sass": "sass src/assets/scss/paper-kit.scss src/assets/css/paper-kit.css",
    "minify-sass": "sass src/assets/scss/paper-kit.scss src/assets/css/paper-kit.min.css --style=compressed",
    "map-sass": "sass src/assets/scss/paper-kit.scss src/assets/css/paper-kit.css",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"

  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },

  "devDependencies": {
    "eslint": "^8.24.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.8",
    "gh-pages": "^6.3.0",
    "prettier": "^2.7.1"
  }
}
